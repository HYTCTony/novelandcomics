<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/col_f8f8f8"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/fl_top_bar_login"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_asBtn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dp_8"
            android:padding="@dimen/dp_8"
            android:src="@drawable/ic_activity_close_gray"
            tools:ignore="ContentDescription" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_title_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/txt_register_title_cellphone"
        android:textColor="@color/txt_black"
        android:textSize="@dimen/sp_22"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_top_bar_login" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctl_cellphone_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="@drawable/shape_round_whitebg"
        android:padding="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_login">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_input_phone_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/txt_plz_input_phone_number"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/col_orange_ea6b3c"
            app:endIconCheckable="true"
            app:endIconDrawable="@mipmap/ic_icon_clear_input"
            app:endIconMode="clear_text"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_phone_number"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:drawableStart="@drawable/ic_cellphone_18dp"
                android:drawablePadding="@dimen/dp_8"
                android:inputType="text"
                android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
                android:singleLine="true"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14"
                app:hintTextColor="@color/txt_gray_b2" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_input_password_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/txt_plz_input_password"
            android:orientation="horizontal"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/col_orange_ea6b3c"
            app:layout_constraintTop_toBottomOf="@+id/til_input_phone_number"
            app:passwordToggleDrawable="@drawable/seletor_account_pwd_visible_btn_bg"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password_1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:drawableStart="@drawable/ic_password_18dp"
                android:drawablePadding="@dimen/dp_8"
                android:inputType="textPassword"
                android:maxLength="18"
                android:singleLine="true"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_input_password_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/txt_plz_comfirm_password"
            android:orientation="horizontal"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/col_orange_ea6b3c"
            app:layout_constraintTop_toBottomOf="@+id/til_input_password_1"
            app:passwordToggleDrawable="@drawable/seletor_account_pwd_visible_btn_bg"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:drawableStart="@drawable/ic_password_18dp"
                android:drawablePadding="@dimen/dp_8"
                android:inputType="textPassword"
                android:maxLength="18"
                android:singleLine="true"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_input_distribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/txt_plz_input_invitation_code"
            android:orientation="horizontal"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/col_orange_ea6b3c"
            app:layout_constraintTop_toBottomOf="@+id/til_input_password_2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_distribution"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:drawableStart="@drawable/ic_invitation_code"
                android:drawablePadding="@dimen/dp_8"
                android:inputType="text"
                android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
                android:maxLength="18"
                android:singleLine="true"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_16"
            android:background="@drawable/ripple_normal_btn_bg_red"
            android:text="@string/txt_regist"
            android:textColor="@color/txt_white"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_input_distribution" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txt1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        android:text="1、用户名不得少于6个字符，并且不大于11个字符"
        android:textColor="@color/txt_gray"
        android:textSize="@dimen/sp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ctl_cellphone_login" />

    <TextView
        android:id="@+id/txt2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        android:text="2、请务必记住自己的账号密码"
        android:textColor="@color/txt_gray"
        android:textSize="@dimen/sp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt1" />

    <TextView
        android:id="@+id/txt3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        android:text="3、不提供密码修改功能"
        android:textColor="@color/col_red_fc4545"
        android:textSize="@dimen/sp_14"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt2" />

    <TextView
        android:id="@+id/txt4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        android:text="5、不提供密码找回功能"
        android:textColor="@color/col_red_fc4545"
        android:textSize="@dimen/sp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt3" />
</androidx.constraintlayout.widget.ConstraintLayout>