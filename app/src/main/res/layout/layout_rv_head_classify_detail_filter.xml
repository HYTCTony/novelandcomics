<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:layout_marginBottom="@dimen/dp_4"
    android:layout_marginTop="@dimen/dp_4"
    android:padding="@dimen/dp_8">

    <com.kongzue.stacklabelview.StackLabel
        android:id="@+id/stackLabelView_filter_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:deleteButton="false"
        app:itemMargin="@dimen/dp_6"
        app:labelBackground="@color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:maxSelectNum="1"
        app:paddingHorizontal="@dimen/dp_8"
        app:paddingVertical="@dimen/dp_4"
        app:selectBackground="@drawable/shape_btn_bg_semicircle_border_red"
        app:selectMode="true"
        app:selectTextColor="@color/txt_red"
        app:textColor="@color/txt_black"
        app:textSize="@dimen/sp_14"
        tools:labels="标签1,标签2,标签3,标签4,标签5,标签6,标签7,标签8,标签9" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8"
        android:background="@color/color_f2"
        app:layout_constraintTop_toBottomOf="@+id/stackLabelView_filter_1" />

    <com.kongzue.stacklabelview.StackLabel
        android:id="@+id/stackLabelView_filter_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:deleteButton="false"
        app:itemMargin="@dimen/dp_6"
        app:labelBackground="@color/transparent"
        app:layout_constraintTop_toBottomOf="@+id/stackLabelView_filter_1"
        app:maxSelectNum="1"
        app:paddingHorizontal="@dimen/dp_8"
        app:paddingVertical="@dimen/dp_4"
        app:selectBackground="@drawable/shape_btn_bg_semicircle_border_red"
        app:selectMode="true"
        app:selectTextColor="@color/txt_red"
        app:textColor="@color/txt_black"
        app:textSize="@dimen/sp_14"
        tools:labels="标签1,标签2,标签3" />

    <TextView
        android:id="@+id/tv_asBtn_more_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8"
        android:text="展开更多筛选"
        app:layout_constraintBottom_toBottomOf="@+id/stackLabelView_filter_2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stackLabelView_filter_2" />


    <LinearLayout
        android:id="@+id/ll_more_filter_layout"
        app:layout_constraintTop_toBottomOf="@+id/stackLabelView_filter_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            android:background="@color/color_f2"
            app:layout_constraintTop_toBottomOf="@+id/stackLabelView_filter_2" />

        <com.kongzue.stacklabelview.StackLabel
            android:id="@+id/stackLabelView_filter_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:deleteButton="false"
            app:itemMargin="@dimen/dp_6"
            app:labelBackground="@color/transparent"
            app:layout_constraintTop_toBottomOf="@+id/stackLabelView_filter_2"
            app:maxSelectNum="1"
            app:paddingHorizontal="@dimen/dp_8"
            app:paddingVertical="@dimen/dp_4"
            app:selectBackground="@drawable/shape_btn_bg_semicircle_border_red"
            app:selectMode="true"
            app:selectTextColor="@color/txt_red"
            app:textColor="@color/txt_black"
            app:textSize="@dimen/sp_14"
            tools:labels="标签1,标签2,标签3,标签4,标签5,标签6,标签7,标签8,标签9" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            android:background="@color/color_f2"
            app:layout_constraintTop_toBottomOf="@+id/stackLabelView_filter_3" />

        <com.kongzue.stacklabelview.StackLabel
            android:id="@+id/stackLabelView_filter_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:deleteButton="false"
            app:itemMargin="@dimen/dp_6"
            app:labelBackground="@color/transparent"
            app:layout_constraintTop_toBottomOf="@+id/stackLabelView_filter_3"
            app:maxSelectNum="1"
            app:paddingHorizontal="@dimen/dp_8"
            app:paddingVertical="@dimen/dp_4"
            app:selectBackground="@drawable/shape_btn_bg_semicircle_border_red"
            app:selectMode="true"
            app:selectTextColor="@color/txt_red"
            app:textColor="@color/txt_black"
            app:textSize="@dimen/sp_14"
            tools:labels="标签1,标签2,标签3,标签4,标签5,标签6,标签7,标签8,标签9" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>