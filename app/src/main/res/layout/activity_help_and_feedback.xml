<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_f2"
    android:fitsSystemWindows="true">

    <include layout="@layout/layout_toolbar" />

    <TextView
        android:id="@+id/tv_asBtn_go2_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8"
        android:padding="@dimen/dp_8"
        android:text="@string/txt_i_want_2_feedback"
        android:textColor="@color/txt_black"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_normal"
        app:layout_constraintRight_toRightOf="@+id/toolbar_normal"
        app:layout_constraintTop_toTopOf="@+id/toolbar_normal" />

    <com.nnmedia.read.ui.widget.ProgressWebview
        android:id="@+id/progressWebview_help_and_feedback"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_normal" />

</androidx.constraintlayout.widget.ConstraintLayout>