<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/read_bg_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/oval_bg_white"
        android:padding="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/read_bg_iv_checked"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_checked"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/read_bg_view"
        app:layout_constraintLeft_toLeftOf="@+id/read_bg_view"
        app:layout_constraintRight_toRightOf="@+id/read_bg_view"
        app:layout_constraintTop_toTopOf="@+id/read_bg_view" />
</androidx.constraintlayout.widget.ConstraintLayout>