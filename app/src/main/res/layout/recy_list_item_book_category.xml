<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_8"
    android:layout_marginEnd="@dimen/dp_16"
    android:layout_marginBottom="@dimen/dp_8"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dp_4"
    app:cardElevation="@dimen/dp_0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_category_name_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:textColor="@color/txt_black"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tv_category_name_child"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="都市生活" />

        <TextView
            android:id="@+id/tv_category_name_child"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_gray_999"
            android:textSize="@dimen/sp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/tv_category_name_parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_category_name_parent"
            tools:text="热血 | 现实" />

        <ImageView
            android:id="@+id/iv_child_category_img_1"
            android:layout_width="31dp"
            android:layout_height="41dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_child_category_img_2"
            app:layout_constraintRight_toLeftOf="@+id/iv_child_category_img_2"
            tools:ignore="ContentDescription"
            tools:src="@mipmap/img_holder_rect" />

        <ImageView
            android:id="@+id/iv_child_category_img_2"
            android:layout_width="31dp"
            android:layout_height="41dp"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/iv_parent_category_img"
            app:layout_constraintRight_toRightOf="parent"
            tools:ignore="ContentDescription"
            tools:src="@mipmap/img_holder_rect" />

        <ImageView
            android:id="@+id/iv_parent_category_img"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/iv_child_category_img_1"
            app:layout_constraintRight_toRightOf="@+id/iv_child_category_img_2"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:src="@mipmap/img_holder_rect" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>