<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.flyco.tablayout.SlidingTabLayout
        android:id="@+id/slidingTabLayout_book_store"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/iv_asBtn_search_bs"
        app:layout_constraintTop_toTopOf="parent"
        app:tl_indicator_color="@color/col_red"
        app:tl_indicator_corner_radius="@dimen/dp_1_5"
        app:tl_indicator_height="@dimen/dp_3"
        app:tl_tab_width="@dimen/dp_56"
        app:tl_indicator_width="@dimen/dp_16"
        app:tl_tab_space_equal="false"
        app:tl_textBold="SELECT"
        app:tl_textSelectColor="@color/txt_black_191919"
        app:tl_textUnselectColor="@color/txt_gray"
        app:tl_textsize="@dimen/sp_18" />

    <ImageView
        android:id="@+id/iv_asBtn_search_bs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_8"
        android:src="@drawable/ic_search_black_24dp"
        app:layout_constraintBottom_toBottomOf="@+id/slidingTabLayout_book_store"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/slidingTabLayout_book_store"
        tools:ignore="ContentDescription" />

    <android.support.v4.view.ViewPager
        android:id="@+id/viewPager_book_store"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slidingTabLayout_book_store" />

</android.support.constraint.ConstraintLayout>