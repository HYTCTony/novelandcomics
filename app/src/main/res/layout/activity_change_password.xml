<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/col_f8f8f8"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/fl_top_bar_login"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_asBtn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dp_8"
            android:padding="@dimen/dp_8"
            android:src="@drawable/ic_activity_close_gray"
            tools:ignore="ContentDescription" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_title_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/txt_change_password"
        android:textColor="@color/txt_black"
        android:textSize="@dimen/sp_22"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_top_bar_login" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctl_cellphone_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="@drawable/shape_round_whitebg"
        android:padding="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_login">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_input_password_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/txt_plz_input_password"
            android:orientation="horizontal"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/col_orange_ea6b3c"
            app:endIconCheckable="true"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password_1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:drawableStart="@drawable/ic_password_18dp"
                android:drawablePadding="@dimen/dp_8"
                android:inputType="textPassword"
                android:maxLength="18"
                android:singleLine="true"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_input_password_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/txt_plz_comfirm_password"
            android:orientation="horizontal"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/col_orange_ea6b3c"
            app:layout_constraintTop_toBottomOf="@+id/til_input_password_1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:drawableStart="@drawable/ic_password_18dp"
                android:drawablePadding="@dimen/dp_8"
                android:inputType="textPassword"
                android:maxLength="18"
                android:singleLine="true"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_16"
            android:background="@drawable/ripple_normal_btn_bg_red"
            android:text="@string/txt_confirm_2_submit"
            android:textColor="@color/txt_white"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_input_password_2" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>