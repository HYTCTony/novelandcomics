<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_f2">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        app:elevation="@dimen/dp_0">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@color/col_red_ff8477"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_247"
                android:background="@drawable/img_frag_welfare_top_bg"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.4"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/ll_asBtn_gold_coin_usable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/btn_click_2_login"
                    app:layout_constraintLeft_toLeftOf="@+id/btn_click_2_login"
                    app:layout_constraintRight_toRightOf="@+id/btn_click_2_login"
                    app:layout_constraintTop_toTopOf="@+id/btn_click_2_login">

                    <TextView
                        android:id="@+id/tv_gold_coin_usable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/txt_white"
                        android:textColorHint="@color/txt_white"
                        android:hint="@string/txt_zero"
                        android:textSize="@dimen/sp_22"
                        android:textStyle="bold"
                        tools:text="2600" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_arrow_right_white_12dp"
                        android:drawablePadding="@dimen/dp_4"
                        android:text="@string/txt_gold_coin_usable"
                        android:textColor="@color/txt_white"
                        android:textSize="@dimen/sp_12" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btn_click_2_login"
                    android:layout_width="@dimen/dp_92"
                    android:layout_height="@dimen/dp_92"
                    android:background="@drawable/ic_img_welfare_login_btn_bg"
                    android:gravity="center"
                    android:text="@string/txt_click_2_login"
                    android:textColor="@color/txt_red"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_sign_in_bar_welfare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_180"
                android:layout_marginEnd="@dimen/dp_16"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dp_8"
                app:cardElevation="@dimen/dp_0"
                app:layout_collapseParallaxMultiplier="0.9">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iv_welfare_login_icon"
                        android:layout_width="@dimen/dp_52"
                        android:layout_height="@dimen/dp_52"
                        android:layout_margin="@dimen/dp_12"
                        android:src="@mipmap/icon_a_man_signin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_gold_coin_count_today_sign_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:hint="@string/hint_not_logged_in"
                        android:textColorHint="@color/txt_black"
                        android:textSize="@dimen/sp_16"
                        app:layout_constraintBottom_toTopOf="@+id/tv_continuous_sign_in_count"
                        app:layout_constraintLeft_toRightOf="@+id/iv_welfare_login_icon"
                        app:layout_constraintTop_toTopOf="@+id/iv_welfare_login_icon" />

                    <TextView
                        android:id="@+id/tv_continuous_sign_in_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:hint="@string/hint_login_2_get_welfare"
                        android:textColorHint="@color/txt_gray"
                        android:textSize="@dimen/sp_12"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_welfare_login_icon"
                        app:layout_constraintLeft_toRightOf="@+id/iv_welfare_login_icon"
                        app:layout_constraintTop_toBottomOf="@+id/tv_gold_coin_count_today_sign_in" />

                    <TextView
                        android:id="@+id/tv_asBtn_sign_in_now"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:background="@drawable/ripple_semicircle_btn_gradual_bg_yellow"
                        android:drawableStart="@drawable/ic_gold_coin"
                        android:drawablePadding="@dimen/dp_4"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/dp_12"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingEnd="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_8"
                        android:text="@string/txt_sign_in_immediately"
                        android:textColor="@color/txt_white"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_welfare_login_icon"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/iv_welfare_login_icon" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_title_bar_welfare"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/transparent"
                android:theme="@style/ToolBarTheme"
                app:layout_collapseMode="pin"
                app:title="">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/txt_welfare_center"
                    android:textColor="@color/txt_white"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    app:layout_collapseMode="pin"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_reading_task"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>