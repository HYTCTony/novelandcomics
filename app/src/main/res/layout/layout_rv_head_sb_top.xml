<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <com.youth.banner.Banner
        android:id="@+id/banner_choiceness"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_8"
        app:banner_default_image="@mipmap/banner_place_holder"
        app:indicator_drawable_selected="@color/col_yellow_f4ea2a"
        app:indicator_drawable_unselected="@color/white"
        app:indicator_height="@dimen/dp_4"
        app:indicator_margin="@dimen/dp_4"
        app:indicator_width="@dimen/dp_16"
        app:layout_constraintDimensionRatio="3:1"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_asBtn_classify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/banner_choiceness">

        <TextView
            android:id="@+id/tv_asBtn_classify"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@drawable/ic_classify_24dp"
            android:drawablePadding="@dimen/dp_4"
            android:gravity="center_horizontal"
            android:padding="@dimen/dp_16"
            android:text="@string/txt_classify"
            android:textColor="@color/txt_black"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/tv_asBtn_ranking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@drawable/ic_classify_24dp"
            android:drawablePadding="@dimen/dp_4"
            android:gravity="center_horizontal"
            android:padding="@dimen/dp_16"
            android:text="@string/txt_ranking"
            android:textColor="@color/txt_black"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/tv_asBtn_new_book"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@drawable/ic_classify_24dp"
            android:drawablePadding="@dimen/dp_4"
            android:gravity="center_horizontal"
            android:padding="@dimen/dp_16"
            android:text="@string/txt_new_book"
            android:textColor="@color/txt_black"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/tv_asBtn_book_finished"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@drawable/ic_classify_24dp"
            android:drawablePadding="@dimen/dp_4"
            android:gravity="center_horizontal"
            android:padding="@dimen/dp_16"
            android:text="@string/txt_end"
            android:textColor="@color/txt_black"
            android:textSize="@dimen/sp_12" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>