<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_f2"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/toolbar_normal"
        layout="@layout/layout_toolbar" />

    <TextView
        android:id="@+id/tv_asBtn_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8"
        android:padding="@dimen/dp_8"
        android:text="@string/txt_search"
        android:textColor="@color/txt_black"
        android:textSize="@dimen/sp_16"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_normal"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar_normal" />

    <EditText
        android:id="@+id/editText_search_keyword"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_36"
        android:layout_marginStart="@dimen/dp_56"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="@drawable/shape_round_edittext_graybg"
        android:drawableStart="@drawable/ic_search_gray"
        android:drawablePadding="@dimen/dp_8"
        android:hint="@string/txt_plz_input_keyword"
        android:imeOptions="actionSearch"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8"
        android:singleLine="true"
        android:textColor="@color/txt_black"
        android:textColorHint="@color/txt_gray"
        android:textSize="@dimen/sp_15"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_normal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_asBtn_search"
        app:layout_constraintTop_toTopOf="@+id/toolbar_normal"
        tools:text="天启时代" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_search_hot_books"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/px_1"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_normal"
        app:layout_constraintVertical_weight="1" />

</androidx.constraintlayout.widget.ConstraintLayout>