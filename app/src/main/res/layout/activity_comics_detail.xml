<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_normal"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/col_black_333"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_white_24dp"
        app:popupTheme="@style/OverflowMenuStyle">

        <TextView
            android:id="@+id/tv_toolbar_center_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginEnd="@dimen/dp_72"
            android:singleLine="true"
            android:textColor="@color/txt_white"
            android:textSize="@dimen/sp_20" />

    </androidx.appcompat.widget.Toolbar>

    <ImageView
        android:id="@+id/iv_asBtn_show_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="@dimen/dp_4"
        android:padding="@dimen/dp_8"
        android:src="@drawable/ic_more_horiz_white_24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_normal"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar_normal"
        tools:ignore="ContentDescription" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scv_comics_detail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/ctl_bottom_bar_dt"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_normal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/col_black_333"
                android:padding="@dimen/dp_16">

                <ImageView
                    android:id="@+id/iv_comics_cover_dt"
                    android:layout_width="@dimen/dp_95"
                    android:layout_height="@dimen/dp_125"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/img_holder_rect"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tv_hot_recommend_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_hottag_bg_book_dt"
                    android:drawableStart="@drawable/ic_hot_12dp"
                    android:drawablePadding="@dimen/dp_2"
                    android:gravity="center_vertical"
                    android:padding="@dimen/dp_3"
                    android:text="@string/txt_recommend"
                    android:textColor="@color/txt_red"
                    android:textSize="@dimen/sp_10"
                    android:visibility="gone"
                    app:layout_constraintLeft_toLeftOf="@+id/iv_comics_cover_dt"
                    app:layout_constraintTop_toTopOf="@+id/iv_comics_cover_dt" />

                <TextView
                    android:id="@+id/tv_comics_name_dt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:textColor="@color/txt_white"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    app:layout_constraintLeft_toRightOf="@+id/iv_comics_cover_dt"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_comics_cover_dt"
                    tools:text="海贼王" />

                <TextView
                    android:id="@+id/tv_comics_author_dt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/txt_white"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toTopOf="@+id/tv_comics_tips_dt"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_comics_name_dt"
                    app:layout_constraintTop_toBottomOf="@+id/tv_comics_name_dt"
                    tools:text="尾田荣一郎" />

                <TextView
                    android:id="@+id/tv_comics_tips_dt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="@color/txt_af80_white"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toTopOf="@+id/tv_comics_score_dt"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_comics_name_dt"
                    app:layout_constraintTop_toBottomOf="@+id/tv_comics_author_dt"
                    tools:text="少年热血·连载·1102话" />

                <TextView
                    android:id="@+id/tv_comics_score_dt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/txt_score_zero"
                    android:textColor="@color/txt_white"
                    android:textColorHint="@color/txt_white"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_comics_cover_dt"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_comics_name_dt" />

                <me.zhanghai.android.materialratingbar.MaterialRatingBar
                    android:id="@+id/ratingBar_comics_score_dt"
                    android:layout_width="80dp"
                    android:layout_height="16dp"
                    android:isIndicator="true"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_comics_score_dt"
                    app:layout_constraintLeft_toRightOf="@+id/tv_comics_score_dt"
                    app:layout_constraintTop_toTopOf="@+id/tv_comics_score_dt"
                    app:mrb_progressBackgroundTint="@color/txt_af80_white"
                    app:mrb_progressTint="@color/col_red"
                    app:mrb_secondaryProgressTint="#FDC4C4"
                    tools:rating="4.5" />

                <View
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="@dimen/dp_12"
                    android:background="#80FFFFFF"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_comics_greet_dt"
                    app:layout_constraintLeft_toRightOf="@+id/ratingBar_comics_score_dt"
                    app:layout_constraintRight_toLeftOf="@+id/tv_comics_greet_dt"
                    app:layout_constraintTop_toTopOf="@+id/tv_comics_greet_dt" />

                <TextView
                    android:id="@+id/tv_comics_greet_dt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/txt_zero"
                    android:textColor="@color/txt_white"
                    android:textColorHint="@color/txt_white"
                    android:textSize="@dimen/sp_14"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_comics_score_dt"
                    app:layout_constraintRight_toLeftOf="@+id/tv_comics_greet_label_dt"
                    app:layout_constraintTop_toTopOf="@+id/tv_comics_score_dt" />

                <TextView
                    android:id="@+id/tv_comics_greet_label_dt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/txt_greet"
                    android:textColor="@color/txt_af80_white"
                    android:textSize="@dimen/sp_10"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_comics_greet_dt"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_comics_greet_dt" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <com.nnmedia.read.ui.widget.ExpandableTextView
                    android:id="@+id/etv_comics_synopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:animDuration="200"
                    app:collapseDrawable="@drawable/icon_orange_arrow_down"
                    app:collapseExpandGrarity="right"
                    app:collapseExpandTextColor="@color/txt_orange_ff6600"
                    app:contentTextColor="@color/txt_black"
                    app:contentTextSize="@dimen/sp_15"
                    app:expandDrawable="@drawable/icon_orange_arrow_up"
                    app:maxCollapsedLines="5"
                    app:textCollapse="@string/collapse"
                    app:textExpand="@string/expand" />

                <com.kongzue.stacklabelview.StackLabel
                    android:id="@+id/stackLabelView_tag_comics_dt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:deleteButton="false"
                    app:itemMargin="@dimen/dp_4"
                    app:labelBackground="@drawable/shape_round_graybg_f8f8f8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:maxSelectNum="1"
                    app:paddingHorizontal="@dimen/dp_8"
                    app:paddingVertical="@dimen/dp_4"
                    app:textColor="@color/txt_black"
                    app:textSize="@dimen/sp_12"
                    tools:labels="少年,热血,冒险,奇幻,战斗" />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rtl_asBtn_newest_section_dt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_4"
                android:background="@drawable/ripple_normal_btn_bg_white">

                <TextView
                    android:id="@+id/tv_newest_section_dt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"
                    android:drawableStart="@drawable/ic_clock_black_18dp"
                    android:drawablePadding="@dimen/dp_6"
                    android:gravity="center_vertical"
                    android:text="@string/txt_newest"
                    android:enabled="false"
                    android:textColor="@color/txt_black_191919"
                    android:textSize="@dimen/sp_16" />

                <TextView
                    android:id="@+id/tv_comics_newest_section_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:layout_toStartOf="@+id/iv_arrow_newest_section"
                    android:layout_toEndOf="@+id/tv_newest_section_dt"
                    android:singleLine="true"
                    android:textColor="@color/txt_gray"
                    android:textSize="@dimen/sp_12"
                    tools:text="第1102话-黎明" />

                <ImageView
                    android:id="@+id/iv_arrow_newest_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:src="@drawable/ic_arrow_right_gray_16dp"
                    tools:ignore="ContentDescription" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rtl_asBtn_comics_catalogue_dt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/px_1"
                android:background="@drawable/ripple_normal_btn_bg_white">

                <TextView
                    android:id="@+id/tv_comics_catalogue_dt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"
                    android:drawableStart="@drawable/ic_catalog_black_18dp"
                    android:drawablePadding="@dimen/dp_6"
                    android:gravity="center_vertical"
                    android:text="@string/txt_catalogue"
                    android:textColor="@color/txt_black_191919"
                    android:textSize="@dimen/sp_16" />

                <TextView
                    android:id="@+id/tv_comics_total_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:layout_toStartOf="@+id/iv_arrow_comics_catalogue"
                    android:layout_toEndOf="@+id/tv_comics_catalogue_dt"
                    android:singleLine="true"
                    android:textColor="@color/txt_gray"
                    android:textSize="@dimen/sp_12"
                    tools:text="共1102话" />

                <ImageView
                    android:id="@+id/iv_arrow_comics_catalogue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:src="@drawable/ic_arrow_right_gray_16dp"
                    tools:ignore="ContentDescription" />
            </RelativeLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:background="@color/white">

                <TextView
                    android:id="@+id/tv_title_hotspot_comics_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:background="@color/white"
                    android:drawableStart="@drawable/shape_title_color_lump"
                    android:drawablePadding="@dimen/dp_6"
                    android:text="@string/txt_hotspot_book_review"
                    android:textColor="@color/txt_black"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:typeface="serif"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_asBtn_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:drawableStart="@drawable/ic_write_review_12dp"
                    android:drawablePadding="@dimen/dp_4"
                    android:gravity="center_vertical"
                    android:text="@string/txt_write_review"
                    android:textColor="@color/txt_red"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_title_hotspot_comics_review"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_title_hotspot_comics_review" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_review"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title_hotspot_comics_review" />

                <TextView
                    android:id="@+id/tv_asBtn_check_more_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16"
                    android:textColor="@color/txt_red"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/recyclerView_review"
                    tools:text="@string/txt_more_review_x" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:background="@color/white">

                <TextView
                    android:id="@+id/tv_title_related_recommendation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:background="@color/white"
                    android:drawableStart="@drawable/shape_title_color_lump"
                    android:drawablePadding="@dimen/dp_6"
                    android:text="@string/txt_recommended_classic"
                    android:textColor="@color/txt_black"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:typeface="serif"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_asBtn_related_recommendation_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:drawableEnd="@drawable/ic_refresh_gray_small"
                    android:drawablePadding="@dimen/dp_4"
                    android:gravity="center_vertical"
                    android:text="@string/txt_get_changed"
                    android:textColor="@color/txt_gray_999"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_title_related_recommendation"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_title_related_recommendation" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_related_recommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_tips_copyright_dt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp_16"
                android:textSize="@dimen/sp_12"
                tools:text="版权说明：本漫画版权所有" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctl_bottom_bar_dt"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/px_1"
            android:background="@color/color_f2"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/btn_download_comics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@mipmap/ic_download" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/txt_download_comics"
                    android:textColor="@color/txt_black_191919"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@mipmap/ic_collect" />

                <TextView
                    android:id="@+id/btn_collect_comics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/txt_collect_comics"
                    android:textColor="@color/txt_black_191919"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <Button
                    android:id="@+id/btn_begin_reading_dt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:background="@drawable/ripple_normal_btn_bg_red"
                    android:text="@string/txt_begin_reading"
                    android:textColor="@color/txt_white"
                    android:textSize="@dimen/sp_16" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
