<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_f2"
    android:fitsSystemWindows="true">

    <include layout="@layout/layout_toolbar" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_8"
        app:cardElevation="@dimen/dp_0"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_normal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_56"
                android:background="@drawable/shape_fox_redbg"
                android:src="@mipmap/icon_fox"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/app_name"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_24" />

            <TextView
                android:id="@+id/tv_cur_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:textColor="@color/txt_gray"
                android:textSize="@dimen/sp_16"
                tools:text="当前版本V0.1.0" />

            <TextView
                android:id="@+id/tv_asBtn_view_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp_8"
                android:textColor="@color/txt_red"
                android:textSize="@dimen/sp_16"
                android:text="@string/txt_view_detail" />

            <Button
                android:id="@+id/btn_update_app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_56"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_36"
                android:background="@drawable/ripple_round_btn_gradual_bg_red"
                android:text="@string/txt_update_version"
                android:textColor="@color/txt_white"
                android:textSize="@dimen/sp_16" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_fox_policy"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="@dimen/dp_28"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_width="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="@dimen/sp_14"
        tools:text="@string/txt_foxread_user_and_privacy_policy"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>