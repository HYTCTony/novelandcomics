<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_16"
    android:background="@color/white"
    android:paddingTop="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_8">

    <ImageView
        android:id="@+id/iv_book_add"
        android:layout_width="@dimen/dp_76"
        android:layout_height="@dimen/dp_0"
        android:background="@drawable/shape_bg_book_shelf"
        android:scaleType="centerInside"
        android:src="@drawable/ic_add_gray_36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="7:9"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:ellipsize="end"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_add"
        android:gravity="center"
        android:text="添加你喜欢的书籍"
        android:textColor="@color/txt_gray_8f9dac"
        android:textSize="@dimen/sp_14"
        app:layout_constraintLeft_toRightOf="@+id/iv_book_add"
        app:layout_constraintTop_toTopOf="@+id/iv_book_add" />


</androidx.constraintlayout.widget.ConstraintLayout>