<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <!--    android:background="@drawable/shape_gradual_bg_reading_perfrence">-->

    <include layout="@layout/layout_toolbar" />

    <RadioGroup
        android:id="@+id/radioGroup_reading_preference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/dp_92"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_boy_novel"
            android:layout_width="@dimen/dp_108"
            android:layout_height="@dimen/dp_108"
            android:background="@drawable/selector_rb_reading_pregerence_boy"
            android:button="@null" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_girl_novel"
            android:layout_width="@dimen/dp_108"
            android:layout_height="@dimen/dp_108"
            android:layout_marginStart="@dimen/dp_36"
            android:background="@drawable/selector_rb_reading_pregerence_girl"
            android:button="@null" />

    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>