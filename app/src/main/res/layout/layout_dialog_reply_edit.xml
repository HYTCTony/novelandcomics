<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ctl_asBtn_reply"
    android:layout_width="match_parent"
    android:background="#F3DFA7"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/px_1"
        android:background="@color/col_d1e2de"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_say_something"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_8"
        android:background="@drawable/shape_round_edittext_graybg"
        android:gravity="center_vertical"
        android:hint="说点什么呢..."
        android:padding="@dimen/dp_8"
        android:lineSpacingMultiplier="1.5"
        android:textColor="@color/txt_black_272f3a"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_reply"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="@drawable/shape_reply_btn_bg"
        android:text="回复"
        android:textColor="@color/txt_white"
        android:textSize="@dimen/sp_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_say_something"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_say_something" />

</androidx.constraintlayout.widget.ConstraintLayout>
