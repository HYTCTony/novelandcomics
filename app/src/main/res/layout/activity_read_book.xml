<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/read_dl_slide"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!--阅读页面-->
            <com.huli.page.widget.read.PageView
                android:id="@+id/read_pv_page"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible" />

            <RelativeLayout
                android:id="@+id/rl"
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/iv_bg_bottom_view"
                    android:layout_width="265dp"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:background="@mipmap/bg_theme_bottom_ad_01"
                    android:visibility="visible" />

                <FrameLayout
                    android:id="@+id/banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:visibility="invisible" />

                <com.qq.e.ads.nativ.widget.NativeAdContainer
                    android:id="@+id/gdt_ad_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/transparent"
                    android:visibility="invisible">

                    <RelativeLayout
                        android:id="@+id/ctl_touch_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/iv_ad_img"
                            android:layout_width="80dp"
                            android:layout_height="40dp"
                            android:scaleType="centerCrop"
                            tools:ignore="ContentDescription"
                            tools:src="@mipmap/img_holder_rect" />

                        <TextView
                            android:id="@+id/tv_iv_ad_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_4"
                            android:layout_marginEnd="@dimen/dp_4"
                            android:layout_toStartOf="@id/tv_ad_source"
                            android:layout_toEndOf="@id/iv_ad_img"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/txt_black_191919"
                            android:textSize="@dimen/sp_12"
                            tools:text="广告Title" />

                        <TextView
                            android:id="@+id/tv_ad_intro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tv_iv_ad_title"
                            android:layout_marginStart="@dimen/dp_4"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="16dp"
                            android:layout_toEndOf="@id/iv_ad_img"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/txt_gray_999"
                            android:textSize="@dimen/sp_10"
                            tools:text="广告desc" />

                        <TextView
                            android:id="@+id/tv_ad_source"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:singleLine="true"
                            android:textSize="@dimen/sp_10"
                            tools:text="广告源" />
                    </RelativeLayout>

                </com.qq.e.ads.nativ.widget.NativeAdContainer>

                <TextView
                    android:id="@+id/btn_bottom_ad"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_reader_bottom_ad"
                    android:clickable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="查看详情"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="invisible" />

            </RelativeLayout>

        </LinearLayout>

        <!--切换页面提示-->
        <TextView
            android:id="@+id/read_tv_page_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/read_ll_bottom_menu"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:background="@color/hl_read_bg_dialog"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingTop="12dp"
            android:paddingRight="8dp"
            android:paddingBottom="12dp"
            android:textColor="@color/txt_gray_b2"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="gone" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/read_abl_top_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/hl_read_bg_dialog"
            android:visibility="gone"
            tools:visibility="gone">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize" />
        </com.google.android.material.appbar.AppBarLayout>

        <!--底部页面-->
        <LinearLayout
            android:id="@+id/read_ll_bottom_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/hl_read_bg_dialog"
            android:clickable="true"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <!--页面进度栏-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/read_tv_pre_chapter"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="上一章"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/read_sb_chapter_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:thumb="@drawable/seekbar_thumb"
                    android:thumbOffset="10dp" />

                <TextView
                    android:id="@+id/read_tv_next_chapter"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="下一章"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />
            </LinearLayout>

            <!--菜单栏-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/read_tv_category"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_read_menu_category"
                    android:drawablePadding="2dp"
                    android:gravity="center_horizontal|bottom"
                    android:padding="4dp"
                    android:text="目录"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/read_tv_night_mode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_read_menu_night"
                    android:drawablePadding="2dp"
                    android:gravity="center_horizontal|bottom"
                    android:padding="4dp"
                    android:text="夜间"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/read_tv_brightness"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_read_menu_brightness"
                    android:drawablePadding="2dp"
                    android:gravity="center_horizontal|bottom"
                    android:padding="4dp"
                    android:text="亮度"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/read_tv_setting"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_read_menu_font"
                    android:drawablePadding="2dp"
                    android:gravity="center_horizontal|bottom"
                    android:padding="4dp"
                    android:text="设置"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listen_ll_bottom_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/hl_read_bg_dialog"
            android:gravity="bottom"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:text="倍速"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="16sp" />

                <com.xw.repo.BubbleSeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="10dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:text="音色"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_voicer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:text="定时"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/txt_gray_b2" />

            <RelativeLayout
                android:id="@+id/listen_setting_speak_paused"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_speak_paused"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="退出阅读模式"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_speak_paused"
                    android:layout_centerHorizontal="true"
                    android:text="科大讯飞提供技术支持"
                    android:textColor="@color/txt_gray"
                    android:textSize="12sp" />
            </RelativeLayout>

        </LinearLayout>
    </RelativeLayout>

    <!--侧滑栏-->
    <LinearLayout
        android:id="@+id/ll_drawer_layout"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/theme_leather_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="标题"
            android:textColor="@color/txt_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_book_statu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="8dp"
            android:text="已完结，共0章"
            android:textColor="@color/txt_black"
            android:textSize="12sp" />

        <View
            android:id="@+id/line_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="@color/light_translucent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>