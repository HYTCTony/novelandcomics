<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/read_dl_slide"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!--阅读页面-->
            <com.nnmedia.page.widget.read.PageView
                android:id="@+id/read_pv_page"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                tools:visibility="visible" />

            <!--            <com.nnmedia.page.widget.read.PageWidget-->
            <!--                android:id="@+id/read_pv_page"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="0dp"-->
            <!--                android:layout_weight="1"-->
            <!--                android:clickable="true"-->
            <!--                android:focusable="true"-->
            <!--                tools:visibility="visible" />-->

            <RelativeLayout
                android:id="@+id/rl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_bg_bottom_view"
                    android:layout_width="265dp"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:background="@mipmap/bg_theme_bottom_ad_01"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/iv_ad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />

                <FrameLayout
                    android:id="@+id/banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:visibility="gone" />

                <RelativeLayout
                    android:id="@+id/ad_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/transparent"
                    android:visibility="visible">

                    <RelativeLayout
                        android:id="@+id/ctl_touch_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/iv_ad_img"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="centerCrop"
                            tools:ignore="ContentDescription"
                            tools:src="@mipmap/img_holder_rect" />

                        <TextView
                            android:id="@+id/tv_iv_ad_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_4"
                            android:layout_marginEnd="@dimen/dp_4"
                            android:layout_toStartOf="@id/tv_ad_source"
                            android:layout_toEndOf="@id/iv_ad_img"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/txt_black_191919"
                            android:textSize="@dimen/sp_12"
                            tools:text="广告Title" />

                        <TextView
                            android:id="@+id/tv_ad_intro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tv_iv_ad_title"
                            android:layout_marginStart="@dimen/dp_4"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="16dp"
                            android:layout_toEndOf="@id/iv_ad_img"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/txt_gray_999"
                            android:textSize="@dimen/sp_10"
                            tools:text="广告desc" />

                        <TextView
                            android:id="@+id/tv_ad_source"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:singleLine="true"
                            android:textSize="@dimen/sp_10"
                            tools:text="广告源" />
                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/iv_close"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_alignParentEnd="true"
                        android:background="@mipmap/ic_close_ad"
                        android:padding="4dp" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/btn_bottom_ad"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_reader_bottom_ad"
                    android:clickable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="查看详情"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="invisible" />

            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_lock_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="50dp"
            android:background="@drawable/shape_book_lock"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_unlock_massage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/dp_10"
                android:text="本章共XX字，解锁需要阅读点：XX"
                android:textColor="@color/hl_read_font_1"
                android:textSize="@dimen/sp_14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/dp_10">

                <TextView
                    android:id="@+id/btn_unlock"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_book_lock_button_1"
                    android:gravity="center"
                    android:text="阅读点不足，去充值"
                    android:textColor="@color/col_red_fc4545"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_get_vip"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_book_lock_button_2"
                    android:gravity="center"
                    android:text="开通VIP，畅享全本"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp_10">

                <TextView
                    android:id="@+id/tv_h_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="阅读点数：0"
                    android:textColor="@color/hl_read_font_1"
                    android:textSize="@dimen/sp_12" />

                <TextView
                    android:id="@+id/btn_go_recharge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_toEndOf="@id/tv_h_point"
                    android:text="@string/txt_go2_recharge2"
                    android:textColor="@color/col_red_fc4545"
                    android:textSize="@dimen/sp_12" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/more_setting_sc_automatic_unlocking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="false"
                    android:longClickable="false"
                    android:text="@string/txt_automatic_unlocking"
                    android:textSize="@dimen/sp_12" />

            </RelativeLayout>
        </LinearLayout>

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/read_abl_top_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/hl_read_bg_dialog"
            android:visibility="gone"
            tools:visibility="gone">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize" />
        </com.google.android.material.appbar.AppBarLayout>

        <!--切换页面提示-->
        <TextView
            android:id="@+id/read_tv_page_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/read_ll_bottom_menu"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:background="@color/hl_read_bg_dialog"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingTop="12dp"
            android:paddingRight="8dp"
            android:paddingBottom="12dp"
            android:textColor="@color/txt_gray_b2"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="gone" />

        <!--底部页面-->
        <LinearLayout
            android:id="@+id/read_ll_bottom_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/hl_read_bg_dialog"
            android:clickable="true"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <!--页面进度栏-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/read_tv_pre_chapter"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="上一章"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/read_sb_chapter_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:thumb="@drawable/seekbar_thumb"
                    android:thumbOffset="10dp" />

                <TextView
                    android:id="@+id/read_tv_next_chapter"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="下一章"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />
            </LinearLayout>

            <!--菜单栏-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/read_tv_category"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_read_menu_category"
                    android:drawablePadding="2dp"
                    android:gravity="center_horizontal|bottom"
                    android:padding="4dp"
                    android:text="目录"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/read_tv_night_mode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_read_menu_night"
                    android:drawablePadding="2dp"
                    android:gravity="center_horizontal|bottom"
                    android:padding="4dp"
                    android:text="夜间"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/read_tv_brightness"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_read_menu_brightness"
                    android:drawablePadding="2dp"
                    android:gravity="center_horizontal|bottom"
                    android:padding="4dp"
                    android:text="亮度"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/read_tv_setting"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_read_menu_font"
                    android:drawablePadding="2dp"
                    android:gravity="center_horizontal|bottom"
                    android:padding="4dp"
                    android:text="设置"
                    android:textColor="@color/txt_gray_b2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <!--侧滑栏-->
    <LinearLayout
        android:id="@+id/ll_drawer_layout"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/theme_leather_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="标题"
            android:textColor="@color/txt_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_book_statu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="8dp"
            android:text="已完结，共0章"
            android:textColor="@color/txt_black"
            android:textSize="12sp" />

        <View
            android:id="@+id/line_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="@color/light_translucent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>