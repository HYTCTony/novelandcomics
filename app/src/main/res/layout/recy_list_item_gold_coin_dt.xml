<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingStart="@dimen/dp_10"
    android:paddingTop="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_10"
    android:paddingBottom="@dimen/dp_12">

    <TextView
        android:id="@+id/tv_gold_coin_count_gc_dt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:textColor="@color/txt_red"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        tools:text="+50" />

    <TextView
        android:id="@+id/tv_title_gc_dt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="@dimen/dp_10"
        android:layout_toStartOf="@+id/tv_gold_coin_count_gc_dt"
        android:textColor="@color/txt_black_191919"
        android:textSize="@dimen/sp_14"
        tools:text="每日30秒计时累计奖励" />

    <TextView
        android:id="@+id/tv_time_gc_dt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title_gc_dt"
        android:layout_marginTop="@dimen/dp_8"
        android:textColor="@color/txt_gray_999"
        android:textSize="@dimen/sp_12"
        tools:text="2020-02-12 13:15:33" />

</RelativeLayout>