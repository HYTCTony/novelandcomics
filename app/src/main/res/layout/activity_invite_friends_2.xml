<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <include layout="@layout/layout_toolbar" />

    <TextView
        android:id="@+id/tv_asBtn_explain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/dp_8"
        android:padding="@dimen/dp_8"
        android:text="@string/txt_explain"
        android:textColor="@color/txt_black_191919"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_normal"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar_normal" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_normal">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.huli.foxread.ui.widget.JsWebView
                android:id="@+id/webView_invite_friend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/toolbar_normal" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ctl_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@color/white"
                android:paddingStart="@dimen/dp_30"
                android:paddingTop="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_30"
                android:paddingBottom="@dimen/dp_16">

                <TextView
                    android:id="@+id/tv_invite_way_wechat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/ic_invite_wechat_48dp"
                    android:drawablePadding="@dimen/dp_8"
                    android:gravity="center_horizontal"
                    android:text="@string/txt_wechat_invite"
                    android:textColor="@color/txt_gray"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_invite_way_moments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/ic_invite_moments_48dp"
                    android:drawablePadding="@dimen/dp_8"
                    android:gravity="center_horizontal"
                    android:text="@string/txt_moments_invite"
                    android:textColor="@color/txt_gray"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/tv_invite_way_wechat"
                    app:layout_constraintRight_toLeftOf="@+id/tv_invite_way_face2face"
                    app:layout_constraintTop_toTopOf="@+id/tv_invite_way_wechat" />

                <TextView
                    android:id="@+id/tv_invite_way_face2face"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/ic_invite_qrcode_48dp"
                    android:drawablePadding="@dimen/dp_8"
                    android:gravity="center_horizontal"
                    android:text="@string/txt_face2face_scan"
                    android:textColor="@color/txt_gray"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_invite_way_wechat" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
