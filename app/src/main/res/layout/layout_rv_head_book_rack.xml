<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_special_recommend"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_6"
        app:cardElevation="@dimen/dp_1"
        app:layout_collapseMode="parallax"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_book_rack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginEnd="@dimen/dp_32"
        android:layout_marginBottom="@dimen/dp_8"
        android:clipChildren="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/dp_8">

            <ImageView
                android:id="@+id/iv_book_cover_push"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="7:9"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription"
                tools:src="@mipmap/img_holder_rect"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_68" />

            <TextView
                android:id="@+id/tv_book_name_push"
                app:layout_constraintBottom_toTopOf="@+id/tv_book_introduction_push"
                app:layout_constraintLeft_toRightOf="@+id/iv_book_cover_push"
                app:layout_constraintTop_toTopOf="@+id/iv_book_cover_push"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:drawableEnd="@drawable/ic_hot"
                android:drawablePadding="@dimen/dp_4"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/txt_black"
                android:textSize="@dimen/sp_14" />

            <TextView
                android:id="@+id/tv_book_introduction_push"
                app:layout_constraintBottom_toBottomOf="@+id/iv_book_cover_push"
                app:layout_constraintLeft_toRightOf="@+id/iv_book_cover_push"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_book_name_push"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/txt_gray"
                android:textSize="@dimen/sp_12" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</FrameLayout>