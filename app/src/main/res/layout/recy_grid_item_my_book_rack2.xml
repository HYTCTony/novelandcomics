<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="4:1"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_book_cover"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="7:9"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:src="@mipmap/img_holder_rect" />

        <TextView
            android:id="@+id/tv_book_name"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/txt_black_191919"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toTopOf="@+id/tv_reading"
            app:layout_constraintLeft_toRightOf="@+id/iv_book_cover"
            app:layout_constraintRight_toLeftOf="@+id/tv_book_state"
            app:layout_constraintTop_toTopOf="@+id/iv_book_cover"
            tools:text="书名" />

        <TextView
            android:id="@+id/tv_book_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_8"
            android:paddingTop="@dimen/dp_2"
            android:paddingEnd="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_2"
            android:singleLine="true"
            android:textSize="@dimen/sp_10"
            app:layout_constraintBottom_toBottomOf="@+id/tv_book_name"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_book_name"
            tools:background="@drawable/shape_border_round2dp_red"
            tools:text="连载"
            tools:textColor="@color/txt_red" />

        <TextView
            android:id="@+id/tv_reading"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:singleLine="true"
            android:textColor="@color/txt_gray_999"
            android:textSize="@dimen/sp_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_book_cover"
            app:layout_constraintLeft_toRightOf="@+id/iv_book_cover"
            app:layout_constraintRight_toLeftOf="@+id/cb_del_select_book_rack"
            app:layout_constraintTop_toBottomOf="@+id/tv_book_name"
            tools:text="读到：第1章" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cb_del_select_book_rack"
            style="@style/Widget.AppCompat.CompoundButton.RadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:theme="@style/MySwitchTheme"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>