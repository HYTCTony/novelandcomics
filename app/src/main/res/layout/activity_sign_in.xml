                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_8"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/recyclerView_sign_week">

                    <TextView
