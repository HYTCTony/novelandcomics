                        android:textSize="@dimen/sp_11"
                        tools:text="本周再签2天可额外获得100金币" />

                    <com.nnmedia.read.ui.widget.TaskProgressBar
                        android:id="@+id/progressBar_sign_task"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_6"
                        android:layout_marginStart="@dimen/dp_12"
                        android:layout_weight="1"
                        app:cpb_isShowDesc="false"
                        app:cpb_progressColor="@color/col_red"
                        app:cpb_progressDescColor="@color/black"
                        app:cpb_progressRadius="@dimen/dp_3"
                        tools:cpb_max="10"
                        tools:cpb_progress="5" />

                    <TextView
                        android:id="@+id/tv_progress_si"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:textColor="@color/txt_black"
                        android:textSize="@dimen/sp_11"
                        tools:text="5/10" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

