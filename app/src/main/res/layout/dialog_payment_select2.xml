<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_top_round_whitebg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_16">

        <TextView
            android:id="@+id/tv_payment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="@string/txt_payment_dialog_title"
            android:textColor="@color/txt_black_191919"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_content_payment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_payment_title"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:textColor="@color/txt_brownness_8b7342"
            android:textSize="@dimen/sp_14"
            tools:text="购买12个月会员" />

        <TextView
            android:id="@+id/tv_need2pay_money_payment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_payment_title"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            android:textColor="@color/txt_red"
            android:textSize="@dimen/sp_12"
            tools:text="需支付：￥118" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_f2"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/rtl_asBtn_payment_pay_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:layout_marginTop="@dimen/px_1"
            android:background="@drawable/ripple_normal_btn_bg_white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:drawableStart="@drawable/ic_payment_alipay"
                android:drawablePadding="@dimen/dp_8"
                android:gravity="center_vertical"
                android:text="支付宝支付①(推荐)"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

            <com.nnmedia.read.ui.widget.CheckBoxSample
                android:id="@+id/checkbox_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_16"
                android:clickable="false" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rtl_asBtn_payment_pay_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:layout_marginTop="@dimen/px_1"
            android:background="@drawable/ripple_normal_btn_bg_white"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:drawableStart="@drawable/ic_payment_alipay"
                android:drawablePadding="@dimen/dp_8"
                android:gravity="center_vertical"
                android:text="支付宝支付②"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

            <com.nnmedia.read.ui.widget.CheckBoxSample
                android:id="@+id/checkbox_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_16"
                android:clickable="false" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rtl_asBtn_payment_pay_3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:layout_marginTop="@dimen/px_1"
            android:background="@drawable/ripple_normal_btn_bg_white"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:drawableStart="@drawable/ic_payment_alipay"
                android:drawablePadding="@dimen/dp_8"
                android:gravity="center_vertical"
                android:text="支付宝支付③"
