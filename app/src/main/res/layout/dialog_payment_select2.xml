                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:drawableStart="@drawable/ic_payment_alipay"
                android:drawablePadding="@dimen/dp_8"
                android:gravity="center_vertical"
                android:text="支付宝支付④"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

            <com.nnmedia.read.ui.widget.CheckBoxSample
                android:id="@+id/checkbox_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_16"
                android:clickable="false" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rtl_asBtn_payment_pay_5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:layout_marginTop="@dimen/px_1"
            android:background="@drawable/ripple_normal_btn_bg_white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:drawableStart="@drawable/ic_payment_wechat"
                android:drawablePadding="@dimen/dp_8"
                android:gravity="center_vertical"
                android:text="微信支付①(推荐)"
                android:textColor="@color/txt_black_191919"
                android:textSize="@dimen/sp_14" />

            <com.nnmedia.read.ui.widget.CheckBoxSample
                android:id="@+id/checkbox_5"
