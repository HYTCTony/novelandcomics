<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_175"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardBackgroundColor="@color/col_red_ff8477"
    app:cardCornerRadius="@dimen/dp_10"
    app:cardElevation="@dimen/dp_0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_excellent_works_show"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_139"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/tv_asBtn_excellent_works_show_all"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="1" />

        <TextView
            android:id="@+id/tv_asBtn_excellent_works_show_all"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:background="@color/off_gray"
            android:gravity="center"
            tools:text="全部"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

