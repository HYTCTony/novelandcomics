<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/express_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="80dp"
        android:layout_weight="1"
        android:gravity="center"
        android:visibility="gone" />

    <!--    <com.qq.e.ads.nativ.widget.NativeAdContainer-->
    <!--        android:id="@+id/gdt_ad_container"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="0dp"-->
    <!--        android:layout_marginStart="24dp"-->
    <!--        android:layout_marginTop="32dp"-->
    <!--        android:layout_marginEnd="24dp"-->
    <!--        android:layout_weight="1"-->
    <!--        android:background="@color/transparent"-->
    <!--        android:visibility="visible"-->
    <!--        tools:visibility="visible">-->

    <LinearLayout
        android:id="@+id/ctl_touch_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:layout_weight="1"
        android:background="@color/transparent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/iv_ad_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                tools:ignore="ContentDescription"
                tools:src="@mipmap/img_holder_rect" />

            <ImageView
                android:id="@+id/ad_logo_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:visibility="gone" />

            <TextView
                android:id="@+id/iv_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_margin="4dp"
                android:background="@color/light_translucent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="去广告"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_12" />
        </FrameLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_ad_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/hl_tips_font_1"
                android:textSize="@dimen/sp_10"
                tools:text="广告源" />

            <TextView
                android:id="@+id/tv_iv_ad_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_toStartOf="@id/tv_ad_source"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/hl_read_font_1"
                android:textSize="@dimen/sp_14"
                tools:text="广告Title" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_ad_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/hl_tips_font_1"
            android:textSize="@dimen/sp_14"
            tools:text="广告desc" />

    </LinearLayout>

    <!--    </com.qq.e.ads.nativ.widget.NativeAdContainer>-->


    <TextView
        android:id="@+id/btn_next_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:maxLines="1"
        android:padding="16dp"
        android:text="点击/滑动可继续阅读"
        android:textColor="@color/txt_gray_b2"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btn_watch_video"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/txt_gray"
        android:textSize="14sp"
        android:visibility="invisible" />

</LinearLayout>
