<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/iv_img_show_picker"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_height="@dimen/dp_0"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_image_show_picker_del22"
        android:layout_width="wrap_content"
        android:padding="@dimen/dp_5"
        android:src="@mipmap/image_show_piceker_del"
        app:layout_constraintRight_toRightOf="@+id/iv_img_show_picker"
        app:layout_constraintTop_toTopOf="@+id/iv_img_show_picker"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>