<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/iv_book_cover_cew"
        android:layout_width="60dp"
        android:layout_height="77dp"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription"
        tools:src="@mipmap/img_holder_rect" />

    <TextView
        android:id="@+id/tv_book_name"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/txt_black"
        android:textSize="@dimen/sp_12"
        app:layout_constraintLeft_toLeftOf="@+id/iv_book_cover_cew"
        app:layout_constraintRight_toRightOf="@+id/iv_book_cover_cew"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_cover_cew"
        tools:text="猎荒者猎荒者" />

    <TextView
        android:id="@+id/tv_book_viewers_cur"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/txt_orange_ff6600"
        android:textSize="@dimen/sp_8"
        app:layout_constraintLeft_toLeftOf="@+id/iv_book_cover_cew"
        app:layout_constraintRight_toRightOf="@+id/iv_book_cover_cew"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name"
        tools:text="259万人在看" />

</androidx.constraintlayout.widget.ConstraintLayout>