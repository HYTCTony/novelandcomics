<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="4:1"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_ad_img"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/img_holder_rect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="7:9"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <com.hytc.ads.AdLogoView
            android:id="@+id/ad_logo_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ad_img"
            app:layout_constraintLeft_toLeftOf="@+id/iv_ad_img" />

        <TextView
            android:id="@+id/tv_iv_ad_title"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="广告Title"
            android:textColor="@color/txt_black_191919"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toTopOf="@+id/iv_ad_intro"
            app:layout_constraintLeft_toRightOf="@+id/iv_ad_img"
            app:layout_constraintRight_toLeftOf="@+id/iv_ad_source"
            app:layout_constraintTop_toTopOf="@+id/iv_ad_img" />

        <TextView
            android:id="@+id/iv_ad_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_8"
            android:paddingTop="@dimen/dp_2"
            android:paddingEnd="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_2"
            android:singleLine="true"
            android:text="标签"
            android:textSize="@dimen/sp_10"
            app:layout_constraintBottom_toBottomOf="@+id/tv_iv_ad_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_iv_ad_title"
            tools:background="@drawable/shape_border_round2dp_red"
            tools:textColor="@color/txt_red" />

        <TextView
            android:id="@+id/iv_ad_intro"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:singleLine="true"
            android:text="XXXXXXXXXXXXXXXXXXX"
            android:textColor="@color/txt_gray_999"
            android:textSize="@dimen/sp_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ad_img"
            app:layout_constraintLeft_toRightOf="@+id/iv_ad_img"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_iv_ad_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>