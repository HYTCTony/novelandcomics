        app:indicator_drawable_selected="@drawable/icon_oval_indicator_yellow"
        app:indicator_drawable_unselected="@drawable/icon_oval_indicator_white"
        app:indicator_height="@dimen/dp_4"
        app:indicator_width="@dimen/dp_4"
        app:indicator_margin="@dimen/dp_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="328:80" />

</androidx.constraintlayout.widget.ConstraintLayout>